DATA_DIR=/data/evidence-runs
SERPAPI_API_KEY=

# Public URL for Bodhi callbacks to reach this service.
PUBLIC_EVIDENCE_SERVICE_URL=

# Bodhi integration.
BODHI_PAT_TOKEN=
# Staging: 912b17f6-819c-437c-9807-4efe44027061
BODHI_PORTFOLIO_TASK_ID=
# Optional. Leave workflow override disabled for API-triggered UI workflows unless
# Bodhi confirms the task metadata has an iterable exec_metadata.workflow graph.
BODHI_ALLOW_WORKFLOW_OVERRIDE=false
BODHI_PORTFOLIO_WORKFLOW_ID=
BODHI_PORTFOLIO_LOCAL_FALLBACK=true
BODHI_PORTFOLIO_HITL_REQUIRED=false
BODHI_PORTFOLIO_HITL_TIMEOUT_SECONDS=45
# Staging: 3166f133-2558-4473-9adb-d3ea8171ec2e
BODHI_AUDITOR_TASK_ID=

# Multi-brand support: these are NOT required. Brand/market/domain are passed
# per-refresh from the frontend. These only exist for backward compatibility
# with older single-brand deployments or CLI scripts.
# DEFAULT_BRAND=Nissan
# DEFAULT_MARKET=Japan
# DEFAULT_DOMAIN=https://www.nissan.co.jp
